{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-pro",
  "update": "disable",
  "snapshots": false,
  "lsp": false,
  "formatter": false,
  "permission": {
    "external_directory": {
      "<REPO>/**": "deny",
      "<USERPROFILE>/.config/opencode/**": "deny",
      "<USERPROFILE>/.local/share/opencode/**": "deny",
      "<ROOT>/evidence/**": "deny",
      "<ROOT>/export/**": "deny",
      "<ROOT>/sessions/**": "deny",
      "<ROOT>/pin/**": "deny",
      "<ROOT>/snapshot-pin/**": "deny"
    }
  }
}