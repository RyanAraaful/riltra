+        std::fs::remove_file(dir.join("a.py")).unwrap();
+        let anchor = super::resolve_edge_anchor_with_source(
+            &conn,
+            snap,
+            &dir,
+            "a.py",
+            0,
+            5,
+            None,
+            Some(&source),
+        )
+        .unwrap();
+        assert_eq!(anchor.display.as_deref(), Some("foo"));
+    }
+
